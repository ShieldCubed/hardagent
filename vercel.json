{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/sovereign",
      "destination": "https://sovereign-delta-six.vercel.app/sovereign/"
    },
    {
      "source": "/sovereign/",
      "destination": "https://sovereign-delta-six.vercel.app/sovereign/"
    },
    {
      "source": "/sovereign/:path*",
      "destination": "https://sovereign-delta-six.vercel.app/sovereign/:path*"
    }
  ]
}
